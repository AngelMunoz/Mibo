<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <FSharpCoreImplicitPackageVersion>10.1.302</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestData.fs" />
    <Compile Include="DomainTests.fs" />
    <Compile Include="MapTests.fs" />
    <Compile Include="EnemiesTests.fs" />
    <Compile Include="SpawningTests.fs" />
    <Compile Include="WavesTests.fs" />
    <Compile Include="EconomyTests.fs" />
    <Compile Include="ProjectionTests.fs" />
    <Compile Include="TowersTests.fs" />
    <Compile Include="ProjectilesTests.fs" />
    <Compile Include="DiagnosticsTests.fs" />
    <Compile Include="CameraTests.fs" />
    <Compile Include="RouterTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Defli\Defli.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" Version="10.2.3" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

</Project>
