<Project>
    <PropertyGroup>
        <RepositoryUrl>https://github.com/AngelMunoz/Mibo</RepositoryUrl>
        <FsDocsLicenseLink>https://github.com/AngelMunoz/Mibo/blob/main/LICENSE</FsDocsLicenseLink>
        <FsDocsReleaseNotesLink>https://github.com/AngelMunoz/Mibo/blob/main/CHANGELOG.md</FsDocsReleaseNotesLink>
        <PackageProjectUrl>https://AngelMunoz.github.io/Mibo</PackageProjectUrl>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <ChangelogFile>$(MSBuildThisFileDirectory)../CHANGELOG.md</ChangelogFile>
        <!-- The readme packed into each package as README.md. Defaults to the
             repo root readme; a project with its own readme (Mibo.Adaptive)
             overrides this before Directory.Build.targets evaluates. -->
        <MiboReadmePath Condition="'$(MiboReadmePath)' == ''">$(MSBuildThisFileDirectory)../README.md</MiboReadmePath>
    </PropertyGroup>
</Project>
