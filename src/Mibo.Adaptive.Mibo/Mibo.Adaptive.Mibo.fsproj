<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mibo.Adaptive.Mibo — the Mibo-side runtime for adaptive programs.
    Hosts the AdaptiveProgram builder/runner and the headless adaptive host
    on top of the Mibo.Core kernel and the dependency-free Mibo.Adaptive
    dataflow library. Backend hosts (Mibo.*.Adaptive) sit on top of this.
  -->

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AdaptiveProgram.fs" />
    <Compile Include="Adaptive.Audio.fs" />
    <Compile Include="Adaptive.Headless.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mibo.Core\Mibo.Core.fsproj" />
    <ProjectReference Include="..\Mibo.Adaptive\Mibo.Adaptive.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ionide.KeepAChangelog.Tasks" Version="0.3.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
