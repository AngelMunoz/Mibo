<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Node.fs" />
    <Compile Include="Xml.fs" />
    <Compile Include="Kdl.fs" />
    <Compile Include="Doc.fs" />
    <Compile Include="DocFlow.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mibo.Core\Mibo.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the KDL front-end's only dependency: MIT, zero dependencies,
         netstandard2.1 -->
    <PackageReference Include="KdlSharp" Version="1.1.0" />
    <!-- versions the package from the repo changelog, like every other
         library in the solution -->
    <PackageReference Include="Ionide.KeepAChangelog.Tasks" Version="0.3.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
