<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GameContext.fs" />
    <Compile Include="Input.fs" />
    <Compile Include="InputMapper.fs" />
    <Compile Include="Animation3D.fs" />
    <Compile Include="Assets.fs" />
    <Compile Include="Runtime.fs" />
    <Compile Include="Animation.fs" />
    <Compile Include="Camera3D.fs" />
    <Compile Include="Culling.fs" />
    <Compile Include="Graphics2D/ShaderLoader.fs" />
    <Compile Include="Graphics3D/Conversions.fs" />
    <Compile Include="Graphics3D/Light3D.fs" />
    <Compile Include="Graphics3D/Material3D.fs" />
    <Compile Include="Graphics3D/Primitive3D.fs" />
    <Compile Include="Graphics3D/Command3D.fs" />
    <Compile Include="Graphics3D/RenderBuffer3D.fs" />
    <Compile Include="Graphics3D/RenderTargetPool3D.fs" />
    <Compile Include="Graphics3D/RenderPipeline3D.fs" />
    <Compile Include="Graphics3D/Renderer3D.fs" />
    <Compile Include="Graphics3D/Pipelines/PostProcess3D.fs" />
    <Compile Include="Graphics3D/Pipelines/SceneData.fs" />
    <Compile Include="Graphics3D/Pipelines/ShadowAtlas.fs" />
    <Compile Include="Graphics3D/Pipelines/ForwardPipeline.fs" />
    <Compile Include="Graphics3D/Draw3D.fs" />
    <Compile Include="Layout3D/Renderer3D.fs" />
    <Compile Include="Graphics2D/Camera2D.fs" />
    <Compile Include="Graphics2D/Lighting/LightTypes.fs" />
    <Compile Include="Graphics2D/Lighting/LightContext.fs" />
    <Compile Include="Graphics2D/Lighting/ParticleTypes.fs" />
    <Compile Include="Graphics2D/Command2D.fs" />
    <Compile Include="Graphics2D/RenderBuffer2D.fs" />
    <Compile Include="Graphics2D/PrimitiveBatch.fs" />
    <Compile Include="Graphics2D/RenderTargetPool.fs" />
    <Compile Include="Graphics2D/Renderer2D.fs" />
    <Compile Include="Graphics2D/Draw.fs" />
    <Compile Include="Graphics2D/Lighting/LightCommands.fs" />
    <Compile Include="Graphics2D/Lighting/GridOccluders.fs" />
    <Compile Include="Graphics2D/Lighting/Particle.fs" />
    <Compile Include="Program.fs" />
    <EmbeddedResource Include="Shaders\LitSprite.dx.mgfx" />
    <EmbeddedResource Include="Shaders\LitSprite.ogl.mgfx" />
    <EmbeddedResource Include="Shaders\LitSpriteNormalMap.dx.mgfx" />
    <EmbeddedResource Include="Shaders\LitSpriteNormalMap.ogl.mgfx" />
    <EmbeddedResource Include="Shaders\Instanced.dx.mgfx" />
    <EmbeddedResource Include="Shaders\Instanced.ogl.mgfx" />
    <EmbeddedResource Include="Shaders\ForwardPbr.dx.mgfx" />
    <EmbeddedResource Include="Shaders\ForwardPbr.ogl.mgfx" />
    <EmbeddedResource Include="Shaders\DepthShadow.dx.mgfx" />
    <EmbeddedResource Include="Shaders\DepthShadow.ogl.mgfx" />
    <None Include="Shaders\*.fx" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mibo.Core\Mibo.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.4.1" PrivateAssets="all" />
    <PackageReference Include="FSharp.UMX" Version="1.1.0" />
    <PackageReference Include="AssimpNetter" Version="6.0.4"/>
  </ItemGroup>

</Project>
